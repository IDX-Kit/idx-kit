---
interface Props {
  status: number;
  subject?: string;
}
const { status, subject = "listing" } = Astro.props;
const message =
  status === 429
    ? "Too many listing requests. Please wait and try again."
    : status === 404
      ? "Listing not found"
      : status === 503
        ? "Listing temporarily unavailable"
        : `Unable to load ${subject === "listing" ? "this listing" : "these results"}`;
---

<h1>{message}</h1>
{status !== 429 && <p>Please try again later.</p>}
