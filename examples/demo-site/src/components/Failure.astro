---
interface Props {
  status: number;
  subject?: string;
}
const { status, subject = "listing" } = Astro.props;
const message =
  status === 404
    ? "Listing not found"
    : status === 503
      ? "Listing temporarily unavailable"
      : `Unable to load ${subject === "listing" ? "this listing" : "these results"}`;
---

<h1>{message}</h1>
<p>Please try again later.</p>
