{
  "name": "@idx-kit/client",
  "version": "0.1.0",
  "description": "TypeScript client for the IDX Kit listings API.",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IDX-Kit/idx-kit.git",
    "directory": "packages/client"
  },
  "type": "module",
  "files": ["dist/generated.js", "dist/generated.d.ts", "dist/LICENSE.md"],
