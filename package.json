{
  "name": "idx-kit",
  "private": true,
  "type": "module",
  "workspaces": ["packages/engine", "packages/client", "examples/demo-site"],
  "engines": {"node": "24.14.1"},
  "scripts": {
    "format": "prettier --write \"{packages,examples,tests,scripts}/**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,astro}\" \"*.{js,cjs,mjs,ts,cts,mts,json}\"",
    "format:check": "prettier --check \"{packages,examples,tests,scripts}/**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,astro}\" \"*.{js,cjs,mjs,ts,cts,mts,json}\"",
    "lint": "eslint . --max-warnings 0",
    "contract:lint": "redocly lint openapi/v1/openapi.yaml --extends recommended --max-problems 1000 --format json > contract-lint.json && node scripts/check-lint.mjs",
    "contract:generate": "redocly generate-client openapi/v1/openapi.yaml --output packages/client/src/generated.ts",
    "contract:compat": "openapi-typescript openapi/v1/openapi.yaml --output .generated/compat.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --project examples/demo-site/tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "test:api": "node --test tests/api/search.test.ts && node --test tests/api/detail.test.ts",
    "test:demo": "playwright test",
    "demo:site:build": "npm run build --workspace @idx-kit/demo-site",
    "demo:site": "npm run start --workspace @idx-kit/demo-site",
    "demo:engine": "node packages/engine/src/runtime/node.ts",
    "demo:key": "node packages/engine/src/runtime/key.ts",
    "demo:db:migrate": "node packages/engine/src/db/migrate.ts",
    "demo:seed": "node packages/engine/src/db/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript-eslint": "8.72.1",
    "@playwright/test": "1.64.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "@redocly/cli": "2.72.1",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
