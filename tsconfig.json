{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "examples/**/*.ts", ".generated/**/*.ts"]
}
