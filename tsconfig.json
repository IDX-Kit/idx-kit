{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", ".generated/**/*.ts", "examples/demo-site/src/env.d.ts"]
}
